<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.bouncycastle" level="TRACE">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="java.util.logging" level="FINEST">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="ALL">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
