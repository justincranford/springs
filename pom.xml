	</parent>

	<groupId>com.github.justincranford.springs</groupId>
	<artifactId>springs-pom</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<name>Spring Applications</name>
	<description>Spring Boot Applications</description>
	<packaging>pom</packaging>

	<url>https://github.com/justincranford/springs</url>

	<inceptionYear>2012</inceptionYear>
	<organization>
		<name>Justin Cranford</name>
		<url>https://github.com/justincranford/springs</url>
	</organization>

	<licenses>
